smip_uav_node:
  ros__parameters:

    # ── ROS interface ────────────────────────────────────────────────────────
    map_frame:          "map"         # Fixed reference frame after correction
    odom_frame:         "odom"        # Odometry frame (may drift)
    sensor_tof_frame:   "tof"         # ToF sensor frame
    pointcloud_topic:   "/tof_pc"     # Input pointcloud
    pointcloud_republish_topic:   "/smip/pointcloud"     # Input pointcloud


    simulation:         false         # Running simulation environment
    tf:                 false         # Complete tf tree available? false if odometry (frd ref)
    visualization_rate: 1.0

    # ── FrameBuilder::Config ─────────────────────────────────────────────────
    builder:
      tof_res_x:            180       # sensor horizontal resolution (pixels)
      tof_res_y:            240       # sensor vertical resolution   (pixels)
      min_range:            0.5       # [m] discard points closer than this
      max_range:            6.0       # [m] discard points farther than this
      pixel_pitch:          0.01071   # [rad/px]  0.5*(tan(hfov/2)/(W/2) + tan(vfov/2)/(H/2))
      enable_ground_filter: false
      ground_z_min:         0.1      # [m] minimum z height kept when ground filter is on
      ds_factor:            1         # spatial downsampling factor (1 = no downsampling)
      edge_normal_th:       0.52      # [rad] normal similarity threshold for edge detection (~30 deg)
      edge_depth_min:       0.02      # [m]   minimum depth step for edge detection

    # ── FrameProcessor::Config ───────────────────────────────────────────────
    processor:
      S_min:                4          # [px] minimum pixel seed spacing (dense far-range limit)
      S_max:                20         # [px] maximum pixel seed spacing (sparse near-range / no-depth fallback)
      perturb_window:       1         # [px] local window for seed perturbation
      min_px:               4        # minimum pixels per surfel segment
      w_spatial:            1.0       # weight of spatial distance in assignment cost
      w_normal:             1.0       # weight of normal distance in assignment cost
      max_cluster_dist:     1.0       # maximum assignment cost to join a cluster

    # ── VoxelGrid::Config ────────────────────────────────────────────────────
    grid:
      voxel_size:           0.5       # [m] spatial resolution of the map voxels (shared with buffer)
      initial_bucket_count: 10000     # hash-map initial bucket reservation
      max_load_factor:      0.75      # hash-map max load factor before rehash

    # ── FrameBuffer::Config ──────────────────────────────────────────────────
    buffer:
      window_size:          6         # sliding window depth (frames)
      corr_normal_cos:      0.9       # minimum cos(angle) for surfel correspondence
      corr_mahal_sq:        2.0       # squared Mahalanobis distance gate for correspondence
      M_min:                2         # minimum track length to commit a surfel

    # ── SurfelMap::Config (GMM integration) ──────────────────────────────────
    map:
      prior_w:              0.01      # prior weight of new MapSurfel (Dirichlet prior)
      spawn_intensity:      0.75       # expected surfels/m³ in unmapped area (spawn rate)
      spawn_residual:       0.5       # residual threshold r_new to spawn a new surfel
      converge_obs_min:     25        # minimum observations before convergence check
      converge_planarity:   0.75      # planarity threshold to mark a surfel converged
      normal_sigma:         0.3927    # [rad] std-dev of normal Gaussian (default pi/8)
      merge_normal_k:       0.5       # merge normal gate at k*sigma (must be <= 1.0)
      merge_min_planarity:  0.5       # minimum planarity for merge candidates
      merge_mahal_sq:       3.0       # squared Mahalanobis distance threshold for merging
      merge_interval:       10        # frames between merge passes
      local_map_window:     25        # rolling frame window for local-map merge scope

open_vins_to_tf:
  ros__parameters:
    px4_odometry: true
    input_topic:  "/fmu/out/vehicle_odometry"
    odom_frame:   "odom"
    body_frame:   "base_link"
    tof_frame:    "tof"
